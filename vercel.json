{
  "redirects": [
    {
      "source": "/sap-training-in-canada",
      "destination": "/sap-course-in-canada",
      "permanent": true
    },
    {
      "source": "/sap-training-in-canada.html",
      "destination": "/sap-course-in-canada",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
